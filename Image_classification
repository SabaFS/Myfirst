from tensorflow.keras.preprocessing.image import ImageDataGenerator
from tensorflow.keras.preprocessing import image
import os

def safe_flow_from_directory(directory, **kwargs):
    generator = ImageDataGenerator(**kwargs)
    for batch_x, batch_y in generator.flow_from_directory(directory, **kwargs):
        # Try loading each image and skip if there's an error
        new_batch_x = []
        new_batch_y = []
        for img, label in zip(batch_x, batch_y):
            try:
                img = image.img_to_array(img)  # Try to convert it to an array
                new_batch_x.append(img)
                new_batch_y.append(label)
            except:
                continue  # Skip this image if it fails to load
        yield new_batch_x, new_batch_y

